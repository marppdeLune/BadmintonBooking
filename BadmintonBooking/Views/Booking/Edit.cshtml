@model BadmintonBooking.Models.Booking

<h2>Edit Booking</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="BookingId" />

    <div class="form-group">
        <label for="Court">Court</label>
        <input type="text" class="form-control" asp-for="Court.CourtName" readonly />
    </div>

    <div class="form-group">
        <label for="StartTime">Start Time</label>
        <input type="datetime" class="form-control" asp-for="StartTime" />
    </div>

    <div class="form-group">
        <label for="EndTime">End Time</label>
        <input type="datetime" class="form-control" asp-for="EndTime" />
    </div>

    <div class="form-group">
        <label for="Price">Price</label>
        <input type="text" class="form-control" asp-for="Price" readonly />
    </div>

    <button type="submit" class="btn btn-success">Save Changes</button>
    <a href="@Url.Action("Index", "Booking")" class="btn btn-secondary">Cancel</a>
</form>
