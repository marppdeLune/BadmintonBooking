@model BadmintonBooking.Models.Booking
@{
    var timeSlot = $"{Model.StartTime.ToString("hh:mm tt")} - {Model.EndTime.ToString("hh:mm tt")}";
}
<h2>Book Court for a Player</h2>

<div class="court-info">
    <h3>@Model.Court.CourtName</h3>
    <p>Date: @Model.StartTime.ToString("dddd, dd/MM/yyyy")</p>
    <p>Time: @Model.StartTime.ToString("h:mm tt") - @Model.EndTime.ToString("h:mm tt")</p>
    <p>Price: $@Model.Price</p>
</div>

<form asp-action="ConfirmBookingForPlayer" method="post">
    <input type="hidden" name="courtId" value="@Model.CourtId" />
    <input type="hidden" name="selectedTimeSlot" value="@timeSlot" />
    <input type="hidden" name="bookingDate" value="@Model.StartTime.ToString("yyyy-MM-dd")" />

    <div class="form-group">
        <label for="playerUsername">Enter Player Username:</label>
        <input type="text" id="playerUsername" name="playerUsername" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">Confirm Booking</button>
    <a href="@Url.Action("Index", "Booking")" class="btn btn-secondary">Cancel</a>
</form>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
Console.WriteLine($"Selected Time Slot: {selectedTimeSlot}");
Console.WriteLine($"Booking Date: {bookingDate}");
Console.WriteLine($"Player Username: {playerUsername}");